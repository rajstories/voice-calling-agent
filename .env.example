# ==============================================================================
# LIVEKIT CREDENTIALS
# Sign up at https://cloud.livekit.io/
# ==============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# ==============================================================================
# STT — Deepgram (Speech-to-Text)
# Sign up at https://console.deepgram.com/
# ==============================================================================
DEEPGRAM_API_KEY=your_deepgram_key

# ==============================================================================
# LLM PROVIDER — Hybrid-Local via Ollama
# Ollama runs locally but ":cloud" model tags proxy to Ollama's cloud backend,
# so heavy inference is offloaded and your M1 RAM stays free.
# Install: https://ollama.com/download
# ==============================================================================
LLM_PROVIDER=local-ollama
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# ":cloud" tag routes inference to Ollama Cloud — no local GPU needed
LOCAL_LLM_MODEL=qwen3:latest
# Alternative cloud-proxied models:
# LOCAL_LLM_MODEL=gemma4:cloud
# LOCAL_LLM_MODEL=llama3.3:cloud

# Fallback cloud LLM options (used when LLM_PROVIDER is set to these values)
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_key

# ==============================================================================
# TTS PROVIDER — Local Kokoro-82M via FastAPI Docker container
# Zero per-character cost, ultra-low latency, 100% local inference.
# Start with: docker compose -f docker-compose.tts.yml up -d
# ==============================================================================
TTS_PROVIDER=local-kokoro
LOCAL_TTS_BASE_URL=http://localhost:8888/v1

# Fallback cloud TTS options (used when TTS_PROVIDER is set to these values)
SARVAM_API_KEY=your_sarvam_key
SARVAM_TTS_VOICE=shubh
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=hi-IN
ELEVENLABS_API_KEY=your_elevenlabs_key

# ==============================================================================
# VOBIZ / SIP TRUNKING
# ==============================================================================
VOBIZ_SIP_TRUNK_ID=your_trunk_id
OUTBOUND_TRUNK_ID=your_trunk_id
VOBIZ_SIP_DOMAIN=your_sip_domain
VOBIZ_USERNAME=your_sip_username
VOBIZ_PASSWORD=your_sip_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX

# ==============================================================================
# RAGFLOW (Optional — External Knowledge Base)
# Self-host: https://github.com/infiniflow/ragflow
# ==============================================================================
RAGFLOW_API_KEY=your_ragflow_api_key
RAGFLOW_BASE_URL=http://your-ragflow-server:9380
